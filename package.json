  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "export": "tsx scripts/export.ts",
    "predev": "npm run export",
    "prebuild": "npm run export",
    "build": "tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
